{
  "request": {
    "method": "GET",
    "urlPattern": "/api/users/by-email/(.+)"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": 1,
      "name": "Test",
      "surname": "User",
      "email": "{{request.pathSegments.[3]}}",
      "birthDate": "1990-01-01",
      "active": true
    }
  }
}
